#: src/AgentX/chat/ResolveChanges.jsx:169
msgid "Delete mine"
msgstr "Șterge-l pe al meu"

#. translators: Button on the AI Agent's unsaved changes bar, beside Delete mine, a verb: keeps the user's unsaved changes so the next Save writes them over the change made elsewhere. Keep it short.
#: public/build/extendify-agentx-5123061faaccc9af69d5.js:1258
#: src/AgentX/chat/ResolveChanges.jsx:180
msgid "Overwrite"
msgstr "Suprascrie"

