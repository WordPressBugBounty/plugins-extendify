msgstr[1] "Linkurile ei din meniul %s rămân și nu vor duce nicăieri."
msgstr[2] "Linkurile ei din meniul %s rămân și nu vor duce nicăieri."

#. translators: %s is the titles of the site's pages that link to the page the AI Agent is about to delete, or how many there are, like "5 pages"; those links stop working.
#: public/build/extendify-agentx-5123061faaccc9af69d5.js:1190
#: src/AgentX/chat/PageCard.jsx:143
#, js-format
msgid "%s links to it, and that link will lead nowhere."
msgid_plural "%s link to it, and those links will lead nowhere."
