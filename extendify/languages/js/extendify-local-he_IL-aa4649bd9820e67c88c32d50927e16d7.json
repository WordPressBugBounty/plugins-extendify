e homepage":["\u05e9\u05d9\u05e0\u05d5\u05d9 \u05d3\u05e3 \u05d4\u05d1\u05d9\u05ea \u05e9\u05dc \u05d4\u05d0\u05ea\u05e8"],"Add a map of where we are":["\u05d4\u05d5\u05e1\u05e3 \u05de\u05e4\u05d4 \u05e9\u05dc \u05d4\u05de\u05d9\u05e7\u05d5\u05dd \u05e9\u05dc\u05e0\u05d5"],"Write a blog post":["\u05db\u05ea\u05d5\u05d1 \u05e4\u05d5\u05e1\u05d8 \u05dc\u05d1\u05dc\u05d5\u05d2"],"Adjust the colors":["\u05db\u05d5\u05d5\u05e0\u05d5\u05df \u05d4\u05e6\u05d1\u05e2\u05d9\u05dd"],"Do you want to adjust the new colors?":["\u05dc\u05db\u05d5\u05d5\u05e0\u05df \u05d0\u05ea \u05d4\u05e6\u05d1\u05e2\u05d9\u05dd \u05d4\u05d7\u05d3\u05e9\u05d9\u05dd?"],"Showing colors to adjust":["\u05de\u05e6\u05d9\u05d2 \u05e6\u05d1\u05e2\u05d9\u05dd \u05dc\u05db\u05d5\u05d5\u05e0\u05d5\u05df"],"Showed colors to adjust":["\u05d4\u05d5\u05e6\u05d2\u05d5 \u05e6\u05d1\u05e2\u05d9\u05dd \u05dc\u05db\u05d5\u05d5\u05e0\u05d5\u05df"],"Couldn't show the colors":["\u05dc\u05d0 \u05d4\u05e6\u05dc\u05d7\u05ea\u05d9 \u05dc\u05d4\u05e6\u05d9\u05d2 \u05d0\u05ea \u05d4\u05e6\u05d1\u05e2\u05d9\u05dd"],"Recommend a plugin":["\u05d4\u05de\u05dc\u05e5 \u05e2\u05dc \u05ea\u05d5\u05e1\u05e3"],"Rename a page":["\u05e9\u05e0\u05d4 \u05e9\u05dd \u05e9\u05dc \u05e2\u05de\u05d5\u05d3"],"Add falling snow to my site":["\u05dc\u05d4\u05d5\u05e1\u05d9\u05e3 \u05e9\u05dc\u05d2 \u05d9\u05d5\u05e8\u05d3 \u05dc\u05d0\u05ea\u05e8 \u05e9\u05dc\u05d9"],"Want to add some falling snow over your site? You can remove this later.":["\u05e8\u05d5\u05e6\u05d4 \u05dc\u05d4\u05d5\u05e1\u05d9\u05e3 \u05e9\u05dc\u05d2 \u05d9\u05d5\u05e8\u05d3 \u05e2\u05dc \u05d4\u05d0\u05ea\u05e8 \u05e9\u05dc\u05da? \u05d0\u05e4\u05e9\u05e8 \u05dc\u05d4\u05e1\u05d9\u05e8 \u05d0\u05ea \u05d6\u05d4 \u05d0\u05d7\u05e8 \u05db\u05da."],"Add snow":["\u05d4\u05d5\u05e1\u05e4\u05ea \u05e9\u05dc\u05d2"],"Adding snow":["\u05de\u05d5\u05e1\u05d9\u05e3 \u05e9\u05dc\u05d2"],"Added snow":["\u05d4\u05e9\u05dc\u05d2 \u05e0\u05d5\u05e1\u05e3"],"Couldn't add snow":["\u05dc\u05d0 \u05d4\u05e6\u05dc\u05d7\u05ea\u05d9 \u05dc\u05d4\u05d5\u05e1\u05d9\u05e3 \u05e9\u05dc\u05d2"]}}}