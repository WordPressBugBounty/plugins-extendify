{"translation-revision-date":"2024-10-31T06:40:28+00:00","generator":"WP-CLI\/2.12.0","source":"src\/AgentX\/chat\/plugin-nudges.js","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","lang":"hi","plural-forms":"nplurals=2; plural=n != 1;"},"Update my phone number":["\u092e\u0947\u0930\u093e \u092b\u093c\u094b\u0928 \u0928\u0902\u092c\u0930 \u0905\u092a\u0921\u0947\u091f \u0915\u0930\u0947\u0902"],"Set up my store":["\u092e\u0947\u0930\u0940 \u0926\u0941\u0915\u093e\u0928 \u0938\u0947\u091f \u0915\u0930\u0947\u0902"],"Show me what you can do":["\u0926\u093f\u0916\u093e\u0907\u090f \u0906\u092a \u0915\u094d\u092f\u093e \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902"],"By the way, I think this needs your attention.":["\u0935\u0948\u0938\u0947, \u092e\u0941\u091d\u0947 \u0932\u0917\u0924\u093e \u0939\u0948 \u0907\u0938 \u092a\u0930 \u0906\u092a\u0915\u093e \u0927\u094d\u092f\u093e\u0928 \u091a\u093e\u0939\u093f\u090f\u0964"],"Do you want to set up your store?":["\u0915\u094d\u092f\u093e \u0905\u092a\u0928\u0940 \u0926\u0941\u0915\u093e\u0928 \u0938\u0947\u091f \u0915\u0930\u0928\u093e \u091a\u093e\u0939\u0947\u0902\u0917\u0947?"],"Your store isn\u2019t set up yet. Want to set it up now?":["\u0906\u092a\u0915\u0940 \u0926\u0941\u0915\u093e\u0928 \u0905\u092d\u0940 \u0938\u0947\u091f \u0928\u0939\u0940\u0902 \u0939\u0941\u0908 \u0939\u0948\u0964 \u0905\u092d\u0940 \u0938\u0947\u091f \u0915\u0930\u0947\u0902?"],"Set up store":["\u0926\u0941\u0915\u093e\u0928 \u0938\u0947\u091f \u0915\u0930\u0947\u0902"],"Do you want to update your phone number next?":["\u0915\u094d\u092f\u093e \u0905\u092c \u0905\u092a\u0928\u093e \u092b\u093c\u094b\u0928 \u0928\u0902\u092c\u0930 \u0905\u092a\u0921\u0947\u091f \u0915\u0930\u0928\u093e \u091a\u093e\u0939\u0947\u0902\u0917\u0947?"],"Update phone number":["\u092b\u093c\u094b\u0928 \u0928\u0902\u092c\u0930 \u0905\u092a\u0921\u0947\u091f \u0915\u0930\u0947\u0902"],"There\u2019s more I can help you with.":["\u092e\u0948\u0902 \u0914\u0930 \u092d\u0940 \u091a\u0940\u091c\u093c\u094b\u0902 \u092e\u0947\u0902 \u0906\u092a\u0915\u0940 \u092e\u0926\u0926 \u0915\u0930 \u0938\u0915\u0924\u093e \u0939\u0942\u0901\u0964"],"Do you want to see what I can do next?":["\u0915\u094d\u092f\u093e \u0905\u092c \u0926\u0947\u0916\u0928\u093e \u091a\u093e\u0939\u0947\u0902\u0917\u0947 \u0915\u093f \u092e\u0948\u0902 \u0915\u094d\u092f\u093e-\u0915\u094d\u092f\u093e \u0915\u0930 \u0938\u0915\u0924\u093e \u0939\u0942\u0901?"],"You\u2019ve finished setting up your website.":["\u0906\u092a\u0928\u0947 \u0905\u092a\u0928\u0940 \u0938\u093e\u0907\u091f \u0938\u0947\u091f \u0915\u0930\u0928\u093e \u092a\u0942\u0930\u093e \u0915\u0930 \u0932\u093f\u092f\u093e \u0939\u0948\u0964"],"You\u2019ve finished setting up your website. If you need anything, just let me know.":["\u0906\u092a\u0928\u0947 \u0905\u092a\u0928\u0940 \u0938\u093e\u0907\u091f \u0938\u0947\u091f \u0915\u0930\u0928\u093e \u092a\u0942\u0930\u093e \u0915\u0930 \u0932\u093f\u092f\u093e \u0939\u0948\u0964 \u0915\u0941\u091b \u092d\u0940 \u091a\u093e\u0939\u093f\u090f \u0939\u094b \u0924\u094b \u092c\u0938 \u092c\u0924\u093e \u0926\u0940\u091c\u093f\u090f\u0964"],"Next we should focus on setting up WooCommerce.":["\u0905\u092c \u0939\u092e\u0947\u0902 WooCommerce \u0938\u0947\u091f \u0915\u0930\u0928\u0947 \u092a\u0930 \u0927\u094d\u092f\u093e\u0928 \u0926\u0947\u0928\u093e \u091a\u093e\u0939\u093f\u090f\u0964"],"You\u2019ve finished setting up your store.":["\u0906\u092a\u0928\u0947 \u0905\u092a\u0928\u0940 \u0926\u0941\u0915\u093e\u0928 \u0938\u0947\u091f \u0915\u0930\u0928\u093e \u092a\u0942\u0930\u093e \u0915\u0930 \u0932\u093f\u092f\u093e \u0939\u0948\u0964"],"You\u2019ve finished setting up your store. If you need anything, just let me know.":["\u0906\u092a\u0928\u0947 \u0905\u092a\u0928\u0940 \u0926\u0941\u0915\u093e\u0928 \u0938\u0947\u091f \u0915\u0930\u0928\u093e \u092a\u0942\u0930\u093e \u0915\u0930 \u0932\u093f\u092f\u093e \u0939\u0948\u0964 \u0915\u0941\u091b \u092d\u0940 \u091a\u093e\u0939\u093f\u090f \u0939\u094b \u0924\u094b \u092c\u0938 \u092c\u0924\u093e \u0926\u0940\u091c\u093f\u090f\u0964"],"Do you want to optimize your images next?":["\u0915\u094d\u092f\u093e \u0905\u092c \u0905\u092a\u0928\u0940 \u091b\u0935\u093f\u092f\u093e\u0901 \u0905\u0928\u0941\u0915\u0942\u0932\u093f\u0924 \u0915\u0930\u0928\u093e \u091a\u093e\u0939\u0947\u0902\u0917\u0947?"],"Imagify is ready now. Want me to optimize the images already on your site?":["Imagify \u0905\u092c \u0924\u0948\u092f\u093e\u0930 \u0939\u0948\u0964 \u0915\u094d\u092f\u093e \u092e\u0948\u0902 \u0906\u092a\u0915\u0940 \u0938\u093e\u0907\u091f \u092a\u0930 \u092a\u0939\u0932\u0947 \u0938\u0947 \u092e\u094c\u091c\u0942\u0926 \u091b\u0935\u093f\u092f\u093e\u0901 \u0905\u0928\u0941\u0915\u0942\u0932\u093f\u0924 \u0915\u0930 \u0926\u0942\u0901?"],"Optimize my images":["\u092e\u0947\u0930\u0940 \u091b\u0935\u093f\u092f\u093e\u0901 \u0905\u0928\u0941\u0915\u0942\u0932\u093f\u0924 \u0915\u0930\u0947\u0902"],"Optimize images":["\u091b\u0935\u093f\u092f\u093e\u0901 \u0905\u0928\u0941\u0915\u0942\u0932\u093f\u0924 \u0915\u0930\u0947\u0902"],"Add API key":["API \u0915\u0941\u0902\u091c\u0940 \u091c\u094b\u0921\u093c\u0947\u0902"],"Do you want to add your Imagify API key next?":["\u0915\u094d\u092f\u093e \u0905\u092c \u0905\u092a\u0928\u0940 Imagify API \u0915\u0941\u0902\u091c\u0940 \u091c\u094b\u0921\u093c\u0928\u093e \u091a\u093e\u0939\u0947\u0902\u0917\u0947?"],"See plans":["\u092a\u094d\u0932\u093e\u0928 \u0926\u0947\u0916\u0947\u0902"],"Do you want to see Imagify\u2019s plans?":["\u0915\u094d\u092f\u093e Imagify \u0915\u0947 \u092a\u094d\u0932\u093e\u0928 \u0926\u0947\u0916\u0928\u093e \u091a\u093e\u0939\u0947\u0902\u0917\u0947?"]}}}