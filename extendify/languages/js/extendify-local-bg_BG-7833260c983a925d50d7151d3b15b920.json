{"translation-revision-date":"2024-08-22T07:03:38+00:00","generator":"WP-CLI\/2.12.0","source":"src\/AgentX\/chat\/plugin-nudges.js","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","lang":"bg","plural-forms":"nplurals=2; plural=n != 1;"},"Update my phone number":["\u041e\u0431\u043d\u043e\u0432\u0435\u0442\u0435 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u043d\u0438\u044f \u043c\u0438 \u043d\u043e\u043c\u0435\u0440"],"Set up my store":["\u041d\u0430\u0441\u0442\u0440\u043e\u0439\u0442\u0435 \u043c\u0430\u0433\u0430\u0437\u0438\u043d\u0430 \u043c\u0438"],"Show me what you can do":["\u041f\u043e\u043a\u0430\u0436\u0435\u0442\u0435 \u043c\u0438 \u043a\u0430\u043a\u0432\u043e \u043c\u043e\u0436\u0435\u0442\u0435"],"By the way, I think this needs your attention.":["\u041c\u0435\u0436\u0434\u0443 \u0434\u0440\u0443\u0433\u043e\u0442\u043e, \u043c\u0438\u0441\u043b\u044f, \u0447\u0435 \u0442\u043e\u0432\u0430 \u0441\u0435 \u043d\u0443\u0436\u0434\u0430\u0435 \u043e\u0442 \u0432\u0430\u0448\u0435\u0442\u043e \u0432\u043d\u0438\u043c\u0430\u043d\u0438\u0435."],"Do you want to set up your store?":["\u0418\u0441\u043a\u0430\u0442\u0435 \u043b\u0438 \u0434\u0430 \u043d\u0430\u0441\u0442\u0440\u043e\u0438\u043c \u043c\u0430\u0433\u0430\u0437\u0438\u043d\u0430 \u0432\u0438?"],"Your store isn\u2019t set up yet. Want to set it up now?":["\u041c\u0430\u0433\u0430\u0437\u0438\u043d\u044a\u0442 \u0432\u0438 \u043e\u0449\u0435 \u043d\u0435 \u0435 \u043d\u0430\u0441\u0442\u0440\u043e\u0435\u043d. \u0418\u0441\u043a\u0430\u0442\u0435 \u043b\u0438 \u0434\u0430 \u0433\u043e \u043d\u0430\u0441\u0442\u0440\u043e\u0438\u043c \u0441\u0435\u0433\u0430?"],"Set up store":["\u041d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0430 \u043d\u0430 \u043c\u0430\u0433\u0430\u0437\u0438\u043d\u0430"],"Do you want to update your phone number next?":["\u0418\u0441\u043a\u0430\u0442\u0435 \u043b\u0438 \u0441\u0435\u0433\u0430 \u0434\u0430 \u043e\u0431\u043d\u043e\u0432\u0438\u043c \u0442