6\u092a\u0915\u0940 \u0938\u093e\u0907\u091f \u092a\u0930 \u0905\u092d\u0940 \u0915\u094b\u0908 \u0938\u093e\u0907\u091f \u0906\u0907\u0915\u0928 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964"],"Do you want to add a site icon next?":["\u0915\u094d\u092f\u093e \u0905\u092c \u0938\u093e\u0907\u091f \u0906\u0907\u0915\u0928 \u091c\u094b\u0921\u093c\u0928\u093e \u091a\u093e\u0939\u0947\u0902\u0917\u0947?"],"Site icon setup":["\u0938\u093e\u0907\u091f \u0906\u0907\u0915\u0928 \u0938\u0947\u091f \u0915\u0930\u0928\u093e"],"Help me add a site icon":["\u0938\u093e\u0907\u091f \u0906\u0907\u0915\u0928 \u091c\u094b\u0921\u093c\u0928\u0947 \u092e\u0947\u0902 \u092e\u0947\u0930\u0940 \u092e\u0926\u0926 \u0915\u0930\u0947\u0902"],"I noticed you still don't have a site icon set. Want to do that now?":["\u092e\u0948\u0902\u0928\u0947 \u0926\u0947\u0916\u093e \u0915\u093f \u0906\u092a\u0928\u0947 \u0905\u092d\u0940 \u0924\u0915 \u0938\u093e\u0907\u091f \u0906\u0907\u0915\u0928 \u0938\u0947\u091f \u0928\u0939\u0940\u0902 \u0915\u093f\u092f\u093e \u0939\u0948\u0964 \u0905\u092d\u0940 \u0915\u0930 \u0932\u0947\u0902?"],"Add site icon":["\u0938\u093e\u0907\u091f \u0906\u0907\u0915\u0928 \u091c\u094b\u0921\u093c\u0947\u0902"],"Your site doesn't have a tagline yet.":["\u0906\u092a\u0915\u0940 \u0938\u093e\u0907\u091f \u092a\u0930 \u0905\u092d\u0940 \u0915\u094b\u0908 \u0938\u094d\u0932\u094b\u0917\u0928 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964"],"Do you want to add a tagline next?":["\u0915\u094d\u092f\u093e \u0905\u092c \u0938\u094d\u0932\u094b\u0917\u0928 \u091c\u094b\u0921\u093c\u0928\u093e \u091a\u093e\u0939\u0947\u0902\u0917\u0947?"],"Tagline setup":["\u0938\u094d\u0932\u094b\u0917\u0928 \u0938\u0947\u091f \u0915\u0930\u0928\u093e"],"Help me write a tagline":["\u0938\u094d\u0932\u094b\u0917\u0928 \u0932\u093f\u0916\u0928\u0947 \u092e\u0947\u0902 \u092e\u0947\u0930\u0940 \u092e\u0926\u0926 \u0915\u0930\u0947\u0902"],"I noticed you still don't have a tagline set. Want to do that now?":["\u092e\u0948\u0902\u0928\u0947 \u0926\u0947\u0916\u093e \u0915\u093f \u0906\u092a\u0928\u0947 \u0905\u092d\u0940 \u0924\u0915 \u0938\u094d\u0932\u094b\u0917\u0928 \u0938\u0947\u091f \u0928\u0939\u0940\u0902 \u0915\u093f\u092f\u093e \u0939\u0948\u0964 \u0905\u092d\u0940 \u0915\u0930 \u0932\u0947\u0902?"],"Add tagline":["\u0938\u094d\u0932\u094b\u0917\u0928 \u091c\u094b\u0921\u093c\u0947\u0902"],"Site visibility":["\u0938\u093e\u0907\u091f \u0915\u0940 \u0926\u0943\u0936\u094d\u092f\u0924\u093e"],"Your site isn't live yet, so visitors see a Coming Soon page.":["\u0906\u092a\u0915\u0940 \u0938\u093e\u0907\u091f \u0905\u092d\u0940 \u0932\u093e\u0907\u0935 \u0928\u0939\u0940\u0902 \u0939\u0948, \u0907\u0938\u0932\u093f\u090f \u0906\u0917\u0902\u0924\u0941\u0915\u094b\u0902 \u0915\u094b \u201c\u091c\u0932\u094d\u0926 \u0906 \u0930\u0939\u093e \u0939\u0948\u201d \u092a\u0943\u0937\u094d\u0920 \u0926\u093f\u0916\u0924\u093e \u0939\u0948\u0964"],"Do you want to publish your site next?":["\u0915\u094d\u092f\u093e \u0905\u092c \u0905\u092a\u0928\u0940 \u0938\u093e\u0907\u091f \u092a\u094d\u0930\u0915\u093e\u0936\u093f\u0924 \u0915\u0930\u0928\u093e \u091a\u093e\u0939\u0947\u0902\u0917\u0947?"],"Site launch":["\u0938\u093e\u0907\u091f \u0915\u0940 \u0936\u0941\u0930\u0941\u0906\u0924"],"Help me publish my site":["\u0905\u092a\u0928\u0940 \u0938\u093e\u0907\u091f \u092a\u094d\u0930\u0915\u093e\u0936\u093f\u0924 \u0915\u0930\u0928\u0947 \u092e\u0947\u0902 \u092e\u0947\u0930\u0940 \u092e\u0926\u0926 \u0915\u0930\u0947\u0902"],"I noticed your site isn't live yet, so visitors see a Coming Soon page. Want to publish it now?":["\u092e\u0948\u0902\u0928\u0947 \u0926\u0947\u0916\u093e \u0915\u093f \u0906\u092a\u0915\u0940 \u0938\u093e\u0907\u091f \u0905\u092d\u0940 \u0932\u093e\u0907\u0935 \u0928\u0939\u0940\u0902 \u0939\u0948, \u0907\u0938\u0932\u093f\u090f \u0906\u0917\u0902\u0924\u0941\u0915\u094b\u0902 \u0915\u094b \u201c\u091c\u0932\u094d\u0926 \u0906 \u0930\u0939\u093e \u0939\u0948\u201d \u092a\u0943\u0937\u094d\u0920 \u0926\u093f\u0916\u0924\u093e \u0939\u0948\u0964 \u0905\u092d\u0940 \u092a\u094d\u0930\u0915\u093e\u0936\u093f\u0924 \u0915\u0930\u0947\u0902?"],"Publish site":["\u0938\u093e\u0907\u091f \u092a\u094d\u0930\u0915\u093e\u0936\u093f\u0924 \u0915\u0930\u0947\u0902"],"Your site still has the colors it started with.":["\u0906\u092a\u0915\u0940 \u0938\u093e\u0907\u091f \u092a\u0930 \u0905\u092c \u092d\u0940 \u0936\u0941\u0930\u0941\u0906\u0924 \u0935\u093e\u0932\u0947 \u0930\u0902\u0917 \u0939\u0948\u0902\u0964"],"Do you want to try new colors next?":["\u0915\u094d\u092f\u093e \u0905\u092c \u0928\u090f \u0930\u0902\u0917 \u0906\u091c\u093c\u092e\u093e\u0928\u093e \u091a\u093e\u0939\u0947\u0902\u0917\u0947?"],"Colors refresh":["\u0930\u0902\u0917 \u0924\u093e\u091c\u093c\u093e \u0915\u0930\u0928\u093e"],"Help me pick new colors":["\u0928\u090f \u0930\u0902\u0917 \u091a\u0941\u0928\u0928\u0947 \u092e\u0947\u0902 \u092e\u0947\u0930\u0940 \u092e\u0926\u0926 \u0915\u0930\u0947\u0902"],"Your colors haven't changed since your site was built %s. Want to try new ones?":["\u0906\u092a\u0915\u0940 \u0938\u093e\u0907\u091f %s \u092c\u0928\u0928\u0947 \u0915\u0947 \u092c\u093e\u0926 \u0938\u0947 \u0930\u0902\u0917 \u0928\u0939\u0940\u0902 \u092c\u0926\u0932\u0947 \u0939\u0948\u0902\u0964 \u0928\u090f \u0906\u091c\u093c\u092e\u093e\u090f\u0901?"],"Your site still has the colors it started with. Want to try new ones?":["\u0906\u092a\u0915\u0940 \u0938\u093e\u0907\u091f \u092a\u0930 \u0905\u092c \u092d\u0940 \u0936\u0941\u0930\u0941\u0906\u0924 \u0935\u093e\u0932\u0947 \u0930\u0902\u0917 \u0939\u0948\u0902\u0964 \u0928\u090f \u0906\u091c\u093c\u092e\u093e\u090f\u0901?"],"Fonts":["\u092b\u093c\u0949\u0928\u094d\u091f"],"Your site still has the fonts it started with.":["\u0906\u092a\u0915\u0940 \u0938\u093e\u0907\u091f \u092a\u0930 \u0905\u092c \u092d\u0940 \u0936\u0941\u0930\u0941\u0906\u0924 \u0935\u093e\u0932\u0947 \u092b\u093c\u0949\u0928\u094d\u091f \u0939\u0948\u0902\u0964"],"Do you want to try new fonts next?":["\u0915\u094d\u092f\u093e \u0905\u092c \u0928\u090f \u092b\u093c\u0949\u0928\u094d\u091f \u0906\u091c\u093c\u092e\u093e\u0928\u093e \u091a\u093e\u0939\u0947\u0902\u0917\u0947?"],"Fonts refresh":["\u092b\u093c\u0949\u0928\u094d\u091f \u0924\u093e\u091c\u093c\u093e \u0915\u0930\u0928\u093e"],"Help me pick new fonts":["\u0928\u090f \u092b\u093c\u0949\u0928\u094d\u091f \u091a\u0941\u0928\u0928\u0947 \u092e\u0947\u0902 \u092e\u0947\u0930\u0940 \u092e\u0926\u0926 \u0915\u0930\u0947\u0902"],"Your fonts haven't changed since your site was built %s. Want to try new ones?":["\u0906\u092a\u0915\u0940 \u0938\u093e\u0907\u091f %s \u092c\u0928\u0928\u0947 \u0915\u0947 \u092c\u093e\u0926 \u0938\u0947 \u092b\u093c\u0949\u0928\u094d\u091f \u0928\u0939\u0940\u0902 \u092c\u0926\u0932\u0947 \u0939\u0948\u0902\u0964 \u0928\u090f \u0906\u091c\u093c\u092e\u093e\u090f\u0901?"],"Your site still has the fonts it started with. Want to try new ones?":["\u0906\u092a\u0915\u0940 \u0938\u093e\u0907\u091f \u092a\u0930 \u0905\u092c \u092d\u0940 \u0936\u0941\u0930\u0941\u0906\u0924 \u0935\u093e\u0932\u0947 \u092b\u093c\u0949\u0928\u094d\u091f \u0939\u0948\u0902\u0964 \u0928\u090f \u0906\u091c\u093c\u092e\u093e\u090f\u0901?"],"Style":["\u0936\u0948\u0932\u0940"],"Your site still has the style it started with.":["\u0906\u092a\u0915\u0940 \u0938\u093e\u0907\u091f \u092a\u0930 \u0905\u092c \u092d\u0940 \u0936\u0941\u0930\u0941\u0906\u0924 \u0935\u093e\u0932\u0940 \u0936\u0948\u0932\u0940 \u0939\u0948\u0964"],"Do you want to try a new style next?":["\u0915\u094d\u092f\u093e \u0905\u092c \u0928\u0908 \u0936\u0948\u0932\u0940 \u0906\u091c\u093c\u092e\u093e\u0928\u093e \u091a\u093e\u0939\u0947\u0902\u0917\u0947?"],"Style refresh":["\u0936\u0948\u0932\u0940 \u0924\u093e\u091c\u093c\u093e \u0915\u0930\u0928\u093e"],"Help me pick a new style":["\u0928\u0908 \u0936\u0948\u0932\u0940 \u091a\u0941\u0928\u0928\u0947 \u092e\u0947\u0902 \u092e\u0947\u0930\u0940 \u092e\u0926\u0926 \u0915\u0930\u0947\u0902"],"Your site's style hasn't changed since it was built %s. Want to try a new one?":["\u0906\u092a\u0915\u0940 \u0938\u093e\u0907\u091f %s \u092c\u0928\u0928\u0947 \u0915\u0947 \u092c\u093e\u0926 \u0938\u0947 \u0909\u0938\u0915\u0940 \u0936\u0948\u0932\u0940 \u0928\u0939\u0940\u0902 \u092c\u0926\u0932\u0940 \u0939\u0948\u0964 \u0928\u0908 \u0906\u091c\u093c\u092e\u093e\u090f\u0901?"],"Your site still has the style it started with. Want to try a new one?":["\u0906\u092a\u0915\u0940 \u0938\u093e\u0907\u091f \u092a\u0930 \u0905\u092c \u092d\u0940 \u0936\u0941\u0930\u0941\u0906\u0924 \u0935\u093e\u0932\u0940 \u0936\u0948\u0932\u0940 \u0939\u0948\u0964 \u0928\u0908 \u0906\u091c\u093c\u092e\u093e\u090f\u0901?"],"Animation":["\u090f\u0928\u093f\u092e\u0947\u0936\u0928"],"Your site still has the animation it started with.":["\u0906\u092a\u0915\u0940 \u0938\u093e\u0907\u091f \u092a\u0930 \u0905\u092c \u092d\u0940 \u0936\u0941\u0930\u0941\u0906\u0924 \u0935\u093e\u0932\u093e \u090f\u0928\u093f\u092e\u0947\u0936\u0928 \u0939\u0948\u0964"],"Do you want to try a new animation next?":["\u0915\u094d\u092f\u093e \u0905\u092c \u0928\u092f\u093e \u090f\u0928\u093f\u092e\u0947\u0936\u0928 \u0906\u091c\u093c\u092e\u093e\u0928\u093e \u091a\u093e\u0939\u0947\u0902\u0917\u0947?"],"Animation refresh":["\u090f\u0928\u093f\u092e\u0947\u0936\u0928 \u0924\u093e\u091c\u093c\u093e \u0915\u0930\u0928\u093e"],"Help me pick an animation":["\u090f\u0928\u093f\u092e\u0947\u0936\u0928 \u091a\u0941\u0928\u0928\u0947 \u092e\u0947\u0902 \u092e\u0947\u0930\u0940 \u092e\u0926\u0926 \u0915\u0930\u0947\u0902"],"Your animation hasn't changed since your site was built %s. Want to try a new one?":["\u0906\u092a\u0915\u0940 \u0938\u093e\u0907\u091f %s \u092c\u0928\u0928\u0947 \u0915\u0947 \u092c\u093e\u0926 \u0938\u0947 \u090f\u0928\u093f\u092e\u0947\u0936\u0928 \u0928\u0939\u0940\u0902 \u092c\u0926\u0932\u093e \u0939\u0948\u0964 \u0928\u092f\u093e \u0906\u091c\u093c\u092e\u093e\u090f\u0901?"],"Your site still has the animation it started with. Want to try a new one?":["\u0906\u092a\u0915\u0940 \u0938\u093e\u0907\u091f \u092a\u0930 \u0905\u092c \u092d\u0940 \u0936\u0941\u0930\u0941\u0906\u0924 \u0935\u093e\u0932\u093e \u090f\u0928\u093f\u092e\u0947\u0936\u0928 \u0939\u0948\u0964 \u0928\u092f\u093e \u0906\u091c\u093c\u092e\u093e\u090f\u0901?"],"What else can you do?":["\u0906\u092a \u0914\u0930 \u0915\u094d\u092f\u093e \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902?"],"What can you help me with?":["\u0906\u092a \u0915\u093f\u0928 \u091a\u0940\u091c\u093c\u094b\u0902 \u092e\u0947\u0902 \u092e\u0926\u0926 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902?"],"Show me what else you can do":["\u0926\u093f\u0916\u093e\u0907\u090f \u0906\u092a \u0914\u0930 \u0915\u094d\u092f\u093e \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902"],"Install %s":["%s \u0907\u0902\u0938\u094d\u091f\u0949\u0932 \u0915\u0930\u0947\u0902"],"Image optimization in 1-click: compress, resize & convert to WebP\/AVIF \u2013 free up to 20MB\/month.":["\u090f\u0915 \u0915\u094d\u0932\u093f\u0915 \u092e\u0947\u0902 \u091b\u0935\u093f \u0905\u0928\u0941\u0915\u0942\u0932\u0928: \u0938\u0902\u092a\u0940\u0921\u093c\u0928, \u0906\u0915\u093e\u0930 \u092c\u0926\u0932\u0928\u093e \u0914\u0930 WebP\/AVIF \u092e\u0947\u0902 \u092c\u0926\u0932\u0928\u093e \u2013 \u0939\u0930 \u092e\u0939\u0940\u0928\u0947 20MB \u0924\u0915 \u092e\u0941\u092b\u093c\u094d\u0924\u0964"],"Do you want to install %s next?":["\u0915\u094d\u092f\u093e \u0905\u092c %s \u0907\u0902\u0938\u094d\u091f\u0949\u0932 \u0915\u0930\u0928\u093e \u091a\u093e\u0939\u0947\u0902\u0917\u0947?"],"%1$d of your images are waiting to be optimized. Imagify\u2019s free %2$s for this month is used up.":["\u0906\u092a\u0915\u0940 %1$d \u091b\u0935\u093f\u092f\u093e\u0901 \u0905\u0928\u0941\u0915\u0942\u0932\u0928 \u0915\u093e \u0907\u0902\u0924\u091c\u093c\u093e\u0930 \u0915\u0930 \u0930\u0939\u0940 \u0939\u0948\u0902\u0964 \u0907\u0938 \u092e\u0939\u0940\u0928\u0947 \u0915\u093e Imagify \u0915\u093e \u092e\u0941\u092b\u093c\u094d\u0924 %2$s \u0916\u0924\u094d\u092e \u0939\u094b \u091a\u0941\u0915\u093e \u0939\u0948\u0964"],"Image optimization":["\u091b\u0935\u093f \u0905\u0928\u0941\u0915\u0942\u0932\u0928"],"Edit my site profile":["\u092e\u0947\u0930\u0940 \u0938\u093e\u0907\u091f \u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932 \u0938\u0902\u092a\u093e\u0926\u093f\u0924 \u0915\u0930\u0947\u0902"],"Change website time zone":["\u0938\u093e\u0907\u091f \u0915\u093e \u0938\u092e\u092f \u0915\u094d\u0937\u0947\u0924\u094d\u0930 \u092c\u0926\u0932\u0947\u0902"],"Change date and time format":["\u0924\u093e\u0930\u0940\u0916\u093c \u0914\u0930 \u0938\u092e\u092f \u0915\u093e \u092a\u094d\u0930\u093e\u0930\u0942\u092a \u092c\u0926\u0932\u0947\u0902"],"Change first day of the week":["\u0938\u092a\u094d\u0924\u093e\u0939 \u0915\u093e \u092a\u0939\u0932\u093e \u0926\u093f\u0928 \u092c\u0926\u0932\u0947\u0902"],"Change website language":["\u0938\u093e\u0907\u091f \u0915\u0940 \u092d\u093e\u0937\u093e \u092c\u0926\u0932\u0947\u0902"],"Change posts per blog page":["\u092c\u094d\u0932\u0949\u0917 \u092a\u0943\u0937\u094d\u0920 \u092a\u0930 \u092a\u094b\u0938\u094d\u091f \u0915\u0940 \u0938\u0902\u0916\u094d\u092f\u093e \u092c\u0926\u0932\u0947\u0902"],"Change comment settings":["\u091f\u093f\u092a\u094d\u092a\u0923\u0940 \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 \u092c\u0926\u0932\u0947\u0902"],"Change website homepage":["\u0938\u093e\u0907\u091f \u0915\u093e \u0939\u094b\u092e \u092a\u0943\u0937\u094d\u0920 \u092c\u0926\u0932\u0947\u0902"],"Add a map of where we are":["\u0939\u092e \u0915\u0939\u093e\u0901 \u0939\u0948\u0902, \u0907\u0938\u0915\u093e \u0928\u0915\u094d\u0936\u093e \u091c\u094b\u0921\u093c\u0947\u0902"],"Write a blog post":["\u090f\u0915 \u092c\u094d\u0932\u0949\u0917 \u092a\u094b\u0938\u094d\u091f \u0932\u093f\u0916\u0947\u0902"],"Adjust the colors":["\u0930\u0902\u0917 \u0938\u092e\u093e\u092f\u094b\u091c\u093f\u0924 \u0915\u0930\u0947\u0902"],"Do you want to adjust the new colors?":["\u0915\u094d\u092f\u093e \u0928\u090f \u0930\u0902\u0917 \u0938\u092e\u093e\u092f\u094b\u091c\u093f\u0924 \u0915\u0930\u0928\u093e \u091a\u093e\u0939\u0947\u0902\u0917\u0947?"],"Showing colors to adjust":["\u0938\u092e\u093e\u092f\u094b\u091c\u093f\u0924 \u0915\u0930\u0928\u0947 \u0932\u093e\u092f\u0915 \u0930\u0902\u0917 \u0926\u093f\u0916\u093e \u0930\u0939\u093e \u0939\u0942\u0901"],"Showed colors to adjust":["\u0938\u092e\u093e\u092f\u094b\u091c\u093f\u0924 \u0915\u0930\u0928\u0947 \u0932\u093e\u092f\u0915 \u0930\u0902\u0917 \u0926\u093f\u0916\u093e\u090f"],"Couldn't show the colors":["\u0930\u0902\u0917 \u0928\u0939\u0940\u0902 \u0926\u093f\u0916\u093e\u090f \u091c\u093e \u0938\u0915\u0947"],"Recommend a plugin":["\u0915\u094b\u0908 \u092a\u094d\u0932\u0917\u0907\u0928 \u0938\u0941\u091d\u093e\u090f\u0901"],"Rename a page":["\u092a\u0943\u0937\u094d\u0920 \u0915\u093e \u0928\u093e\u092e \u092c\u0926\u0932\u0947\u0902"],"Add falling snow to my site":["\u092e\u0947\u0930\u0940 \u0938\u093e\u0907\u091f \u092a\u0930 \u0917\u093f\u0930\u0924\u0940 \u092c\u0930\u094d\u092b\u093c \u091c\u094b\u0921\u093c\u0947\u0902"],"Want to add some falling snow over your site? You can remove this later.":["\u0915\u094d\u092f\u093e \u0906\u092a \u0905\u092a\u0928\u0940 \u0938\u093e\u0907\u091f \u092a\u0930 \u0917\u093f\u0930\u0924\u0940 \u0939\u0941\u0908 \u092c\u0930\u094d\u092b\u093c \u091c\u094b\u0921\u093c\u0928\u093e \u091a\u093e\u0939\u0924\u0947 \u0939\u0948\u0902? \u0906\u092a \u0907\u0938\u0947 \u092c\u093e\u0926 \u092e\u0947\u0902 \u0939\u091f\u093e \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964"],"Add snow":["\u092c\u0930\u094d\u092b\u093c\u092c\u093e\u0930\u0940 \u091c\u094b\u0921\u093c\u0947\u0902"],"Adding snow":["\u092c\u0930\u094d\u092b\u093c \u091c\u094b\u0921\u093c\u0928\u093e"],"Added snow":["\u092c\u0930\u094d\u092b\u093c\u092c\u093e\u0930\u0940 \u091c\u094b\u0921\u093c\u0940"],"Couldn't add snow":["\u092c\u0930\u094d\u092b\u093c\u092c\u093e\u0930\u0940 \u0928\u0939\u0940\u0902 \u091c\u094b\u0921\u093c\u0940 \u091c\u093e \u0938\u0915\u0940"]}}}