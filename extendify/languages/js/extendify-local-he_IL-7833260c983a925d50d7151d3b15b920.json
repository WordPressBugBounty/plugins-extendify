{"translation-revision-date":"2025-07-29T07:10:10+00:00","generator":"WP-CLI\/2.12.0","source":"src\/AgentX\/chat\/plugin-nudges.js","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","lang":"he_IL","plural-forms":"nplurals=2; plural=n != 1;"},"Update my phone number":["\u05e2\u05d3\u05db\u05df \u05d0\u05ea \u05de\u05e1\u05e4\u05e8 \u05d4\u05d8\u05dc\u05e4\u05d5\u05df \u05e9\u05dc\u05d9"],"Set up my store":["\u05d4\u05e7\u05dd \u05d0\u05ea \u05d4\u05d7\u05e0\u05d5\u05ea \u05e9\u05dc\u05d9"],"Show me what you can do":["\u05d4\u05e8\u05d0\u05d4 \u05dc\u05d9 \u05de\u05d4 \u05d0\u05ea\u05d4 \u05d9\u05d5\u05d3\u05e2 \u05dc\u05e2\u05e9\u05d5\u05ea"],"By the way, I think this needs your attention.":["\u05d3\u05e8\u05da \u05d0\u05d2\u05d1, \u05e0\u05e8\u05d0\u05d4 \u05dc\u05d9 \u05e9\u05d6\u05d4 \u05d3\u05d5\u05e8\u05e9 \u05d0\u05ea \u05ea\u05e9\u05d5\u05de\u05ea \u05dc\u05d1\u05da."],"Do you want to set up your store?":["\u05dc\u05d4\u05e7\u05d9\u05dd \u05d0\u05ea \u05d4\u05d7\u05e0\u05d5\u05ea \u05e9\u05dc\u05da?"],"Your store isn\u2019t set up yet. Want to set it up now?":["\u05d4\u05d7\u05e0\u05d5\u05ea \u05e9\u05dc\u05da \u05e2\u05d3\u05d9\u05d9\u05df \u05dc\u05d0 \u05d4\u05d5\u05e7\u05de\u05d4. \u05dc\u05d4\u05e7\u05d9\u05dd \u05d0\u05d5\u05ea\u05d4 \u05e2\u05db\u05e9\u05d9\u05d5?"],"Set up store":["\u05d4\u05e7\u05de\u05ea \u05d4\u05d7\u05e0\u05d5\u05ea"],"Do you want to update your phone number next?":["\u05dc\u05e2\u05d3\u05db\u05df \u05e2\u05db\u05e9\u05d9\u05d5 \u05d0\u05ea \u05de\u05e1\u05e4\u05e8 \u05d4\u05d8\u05dc\u05e4\u05d5\u05df \u05e9\u05dc\u05da?"],"Update phone number":["\u05e2\u05d3\u05db\u05d5\u05df \u05de\u05e1\u05e4\u05e8 \u05d4\u05d8\u05dc\u05e4\u05d5\u05df"],"There\u2019s more I can help you with.":["\u05d0\u05e0\u05d9 \u05d9\u05db\u05d5\u05dc \u05dc\u05e2\u05d6\u05d5\u05e8 \u05dc\u05da \u05d2\u05dd \u05d1\u05d3\u05d1\u05e8\u05d9\u05dd \u05e0\u05d5\u05e1\u05e4\u05d9\u05dd."],"Do you want to see what I can do next?":["\u05dc\u05e8\u05d0\u05d5\u05ea \u05e2\u05db\u05e9\u05d9\u05d5 \u05de\u05d4 \u05d0\u05e0\u05d9 \u05d9\u05d5\u05d3\u05e2 \u05dc\u05e2\u05e9\u05d5\u05ea?"],"You\u2019ve finished setting up your website.":["\u05e1\u05d9\u05d9\u05de\u05ea \u05dc\u05d4\u05e7\u05d9\u05dd \u05d0\u05ea \u05d4\u05d0\u05ea\u05e8 \u05e9\u05dc\u05da."],"You\u2019ve finished setting up your website. If you need anything, just let me know.":["\u05e1\u05d9\u05d9\u05de\u05ea \u05dc\u05d4\u05e7\u05d9\u05dd \u05d0\u05ea \u05d4\u05d0\u05ea\u05e8 \u05e9\u05dc\u05da. \u05d0\u05dd \u05ea\u05e6\u05d8\u05e8\u05da \u05de\u05e9\u05d4\u05d5, \u05e4\u05e9\u05d5\u05d8 \u05ea\u05d2\u05d9\u05d3."],"Next we should focus on setting up WooCommerce.":["\u05d4\u05e9\u05dc\u05d1 \u05d4\u05d1\u05d0 \u05d4\u05d5\u05d0 \u05dc\u05d4\u05e7\u05d9\u05dd \u05d0\u05ea WooCommerce."],"You\u2019ve finished setting up your store.":["\u05e1\u05d9\u05d9\u05de\u05ea \u05dc\u05d4\u05e7\u05d9\u05dd \u05d0\u05ea \u05d4\u05d7\u05e0\u05d5\u05ea \u05e9\u05dc\u05da."],"You\u2019ve finished setting up your store. If you need anything, just let me know.":["\u05e1\u05d9\u05d9\u05de\u05ea \u05dc\u05d4\u05e7\u05d9\u05dd \u05d0\u05ea \u05d4\u05d7\u05e0\u05d5\u05ea \u05e9\u05dc\u05da. \u05d0\u05dd \u05ea\u05e6\u05d8\u05e8\u05da \u05de\u05e9\u05d4\u05d5, \u05e4\u05e9\u05d5\u05d8 \u05ea\u05d2\u05d9\u05d3."],"Do you want to optimize your images next?":["\u05dc\u05d1\u05e6\u05e2 \u05e2\u05db\u05e9\u05d9\u05d5 \u05d0\u05d5\u05e4\u05d8\u05d9\u05de\u05d9\u05d6\u05e6\u05d9\u05d4 \u05dc\u05ea\u05de\u05d5\u05e0\u05d5\u05ea \u05e9\u05dc\u05da?"],"Imagify is ready now. Want me to optimize the images already on your site?":["Imagify \u05de\u05d5\u05db\u05df. \u05e9\u05d0\u05d1\u05e6\u05e2 \u05d0\u05d5\u05e4\u05d8\u05d9\u05de\u05d9\u05d6\u05e6\u05d9\u05d4 \u05dc\u05ea\u05de\u05d5\u05e0\u05d5\u05ea \u05e9\u05db\u05d1\u05e8 \u05e0\u05de\u05e6\u05d0\u05d5\u05ea \u05d1\u05d0\u05ea\u05e8 \u05e9\u05dc\u05da?"],"Optimize my images":["\u05d1\u05e6\u05e2 \u05d0\u05d5\u05e4\u05d8\u05d9\u05de\u05d9\u05d6\u05e6\u05d9\u05d4 \u05dc\u05ea\u05de\u05d5\u05e0\u05d5\u05ea \u05e9\u05dc\u05d9"],"Optimize images":["\u05d0\u05d5\u05e4\u05d8\u05d9\u05de\u05d9\u05d6\u05e6\u05d9\u05d4 \u05dc\u05ea\u05de\u05d5\u05e0\u05d5\u05ea"],"Add API key":["\u05d4\u05d5\u05e1\u05e4\u05ea \u05de\u05e4\u05ea\u05d7 API"],"Do you want to add your Imagify API key next?":["\u05dc\u05d4\u05d5\u05e1\u05d9\u05e3 \u05e2\u05db\u05e9\u05d9\u05d5 \u05d0\u05ea \u05de\u05e4\u05ea\u05d7 \u05d4-API \u05e9\u05dc Imagify?"],"See plans":["\u05d4\u05e6\u05d2\u05ea \u05d4\u05d7\u05d1\u05d9\u05dc\u05d5\u05ea"],"Do you want to see Imagify\u2019s plans?":["\u05dc\u05e8\u05d0\u05d5\u05ea \u05d0\u05ea \u05d4\u05d7\u05d1\u05d9\u05dc\u05d5\u05ea \u05e9\u05dc Imagify?"]}}}