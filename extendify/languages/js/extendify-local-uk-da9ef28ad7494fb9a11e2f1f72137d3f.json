1\u0430\u0439\u0442\u0443."],"Site speed":["\u0428\u0432\u0438\u0434\u043a\u0456\u0441\u0442\u044c \u0441\u0430\u0439\u0442\u0443"],"Your site is running slowly. Here are actions to take:":["\u0422\u0432\u0456\u0439 \u0441\u0430\u0439\u0442 \u043f\u0440\u0430\u0446\u044e\u0454 \u043f\u043e\u0432\u0456\u043b\u044c\u043d\u043e. \u041e\u0441\u044c \u0449\u043e \u043c\u043e\u0436\u043d\u0430 \u0437\u0440\u043e\u0431\u0438\u0442\u0438:"],"Imagify has optimized %s worth of images this month. Upgrade to the <a>Growth<\/a> plan to continue optimizing and keep your site running fast.":["\u0426\u044c\u043e\u0433\u043e \u043c\u0456\u0441\u044f\u0446\u044f Imagify \u043e\u043f\u0442\u0438\u043c\u0456\u0437\u0443\u0432\u0430\u0432 %s \u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u044c. \u041f\u0435\u0440\u0435\u0439\u0434\u0438 \u043d\u0430 \u043f\u043b\u0430\u043d <a>Growth<\/a>, \u0449\u043e\u0431 \u043f\u0440\u043e\u0434\u043e\u0432\u0436\u0438\u0442\u0438 \u043e\u043f\u0442\u0438\u043c\u0456\u0437\u0430\u0446\u0456\u044e \u0456 \u0437\u0431\u0435\u0440\u0435\u0433\u0442\u0438 \u0448\u0432\u0438\u0434\u043a\u0456\u0441\u0442\u044c \u0441\u0430\u0439\u0442\u0443."],"Imagify optimized your new image: %1$s \u2192 %2$s, %3$s smaller.":["Imagify \u043e\u043f\u0442\u0438\u043c\u0456\u0437\u0443\u0432\u0430\u0432 \u0442\u0432\u043e\u0454 \u043d\u043e\u0432\u0435 \u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u043d\u044f: %1$s \u2192 %2$s, \u043d\u0430 %3$s \u043c\u0435\u043d\u0448\u0435."],"Heads up: your new image wasn't optimized, since you've used all %s of this month's free Imagify optimization. Upgrade to keep your images optimized.":["\u0423\u0432\u0430\u0433\u0430: \u0442\u0432\u043e\u0454 \u043d\u043e\u0432\u0435 \u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u043d\u044f \u043d\u0435 \u043e\u043f\u0442\u0438\u043c\u0456\u0437\u0443\u0432\u0430\u043b\u0438, \u0431\u043e \u0442\u0438 \u0432\u0438\u0442\u0440\u0430\u0442\u0438\u0432 \u0443\u0441\u0456 %s \u0431\u0435\u04