{"translation-revision-date":"2024-08-13 08:44+0200","generator":"WP-CLI\/2.12.0","source":"src\/AgentX\/chat\/plugin-nudges.js","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","lang":"pl","plural-forms":"nplurals=3; plural=(n == 1) ? 0 : ((n % 10 >= 2 && n % 10 <= 4 && (n % 100 < 12 || n % 100 > 14)) ? 1 : 2);"},"Update my phone number":["Zaktualizuj m\u00f3j numer telefonu"],"Set up my store":["Urz\u0105d\u017a m\u00f3j sklep"],"Show me what you can do":["Poka\u017c, co potrafisz"],"By the way, I think this needs your attention.":["Przy okazji, wydaje mi si\u0119, \u017ce to wymaga twojej uwagi."],"Do you want to set up your store?":["Chcesz urz\u0105dzi\u0107 sw\u00f3j sklep?"],"Your store isn\u2019t set up yet. Want to set it up now?":["Tw\u00f3j sklep nie jest jeszcze urz\u0105dzony. Chcesz to teraz zrobi\u0107?"],"Set up store":["Urz\u0105d\u017a sklep"],"Do you want to update your phone number next?":["Chcesz teraz zaktualizowa\u0107 sw\u00f3j numer telefonu?"],"Update phone number":["Zaktualizuj numer telefonu"],"There\u2019s more I can help you with.":["Mog\u0119 ci pom\u00f3c jeszcze w innych rzeczach."],"Do you want to see what I can do next?":["Chcesz zobaczy\u0107, co potrafi\u0119?"],"You\u2019ve finished setting up your website.":["Sko\u0144czy\u0142e\u015b urz\u0105dza\u0107 swoj\u0105 witryn\u0119."],"You\u2019ve finished setting up your website. If you need anything, just let me know.":["Sko\u0144czy\u0142e\u015b urz\u0105dza\u0107 swoj\u0105 witryn\u0119. Je\u015bli czego\u015b potrzebujesz, po prostu daj zna\u0107."],"Next we should focus on setting up WooCommerce.":["Teraz zajmijmy si\u0119 konfiguracj\u0105 WooCommerce."],"You\u2019ve finished setting up your store.":["Sko\u0144czy\u0142e\u015b urz\u0105dza\u0107 sw\u00f3j sklep."],"You\u2019ve finished setting up your store. If you need anything, just let me know.":["Sko\u0144czy\u0142e\u015b urz\u0105dza\u0107 sw\u00f3j sklep. Je\u015bli czego\u015b potrzebujesz, po prostu daj zna\u0107."],"Do you want to optimize your images next?":["Chcesz teraz zoptymalizowa\u0107 swoje obrazki?"],"Imagify is ready now. Want me to optimize the images already on your site?":["Imagify jest ju\u017c gotowe. Chcesz, \u017cebym zoptymalizowa\u0142 obrazki, kt\u00f3re s\u0105 ju\u017c na twojej witrynie?"],"Optimize my images":["Zoptymalizuj moje obrazki"],"Optimize images":["Zoptymalizuj obrazki"],"Add API key":["Dodaj klucz API"],"Do you want to add your Imagify API key next?":["Chcesz teraz doda\u0107 sw\u00f3j klucz API Imagify?"],"See plans":["Zobacz plany"],"Do you want to see Imagify\u2019s plans?":["Chcesz zobaczy\u0107 plany Imagify?"]}}}