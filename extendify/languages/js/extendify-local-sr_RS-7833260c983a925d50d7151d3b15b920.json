u043e\u0458 \u0431\u0440\u043e\u0458 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0430?"],"Update phone number":["\u0410\u0436\u0443\u0440\u0438\u0440\u0430\u0458 \u0431\u0440\u043e\u0458 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0430"],"There\u2019s more I can help you with.":["\u041c\u043e\u0433\u0443 \u0434\u0430 \u0442\u0438 \u043f\u043e\u043c\u043e\u0433\u043d\u0435\u043c \u0438 \u043e\u043a\u043e \u0434\u0440\u0443\u0433\u0438\u0445 \u0441\u0442\u0432\u0430\u0440\u0438."],"Do you want to see what I can do next?":["\u0416\u0435\u043b\u0438\u0448 \u043b\u0438 \u0434\u0430 \u0432\u0438\u0434\u0438\u0448 \u0448\u0442\u0430 \u0443\u043c\u0435\u043c?"],"You\u2019ve finished setting up your website.":["\u0417\u0430\u0432\u0440\u0448\u0438\u043e \u0441\u0438 \u043f\u043e\u0441\u0442\u0430\u0432\u0459\u0430\u045a\u0435 \u0441\u0432\u043e\u0433 \u0441\u0430\u0458\u0442\u0430."],"You\u2019ve finished setting up your website. If you need anything, just let me know.":["\u0417\u0430\u0432\u0440\u0448\u0438\u043e \u0441\u0438 \u043f\u043e\u0441\u0442\u0430\u0432\u0459\u0430\u045a\u0435 \u0441\u0432\u043e\u0433 \u0441\u0430\u0458\u0442\u0430. \u0410\u043a\u043e \u0442\u0438 \u043d\u0435\u0448\u0442\u043e \u0437\u0430\u0442\u0440\u0435\u0431\u0430, \u0441\u0430\u043c\u043e \u0440\u0435\u0446\u0438."],"Next we should focus on setting up WooCommerce.":["\u0421\u0430\u0434\u0430 \u0434\u0430 \u043f\u043e\u0441\u0442\u0430\u0432\u0438\u043c\u043e WooCommerce."],"You\u2019ve finished setting up your store.":["\u0417\u0430\u0432\u0440\u0448\u0438\u043e \u0441\u0438 \u043f\u043e\u0441\u0442\u0430\u0432\u0459\u0430\u045a\u0435 \u0441\u0432\u043e\u0458\u0435 \u043f\u0440\u043e\u0434\u0430\u0432\u043d\u0438\u0446\u0435."],"You\u2019ve finished setting up your store. If you need anything, just let me know.":["\u0417\u0430\u0432\u0440\u0448\u0438\u043e \u0441\u0438 \u043f\u043e\u0441\u0442\u0430\u0432\u0459\u0430\u045a\u0435 \u0441\u0432\u043e\u0458\u0435 \u043f\u0440\u043e\u0434\u0430\u0432\u043d\u0438\u0446\u0435. \u0410\u043a\u043e \u0442\u0438 \u043d\u0435\u0448\u0442\u043e \u0437\u0430\u0442\u0440\u0435\u0431\u0430, \u0441\u0430\u043c\u043e \u0440\u0435\u0446\u0438."],"Do you want to optimize your images next?":["\u0416\u0435\u043b\u0438\u0448 \u043b\u0438 \u0441\u0430\u0434\u0430 \u0434\u0430 \u043e\u043f\u0442\u0438\u043c\u0438\u0437\u0443\u0458\u0435\u0448 \u0441\u0432\u043e\u0458\u0435 \u0441\u043b\u0438\u043a\u0435?"],"Imagify is ready now. Want me to optimize the images already on your site?":["Imagify \u0458\u0435 \u0441\u0430\u0434\u0430 \u0441\u043f\u0440\u0435\u043c\u0430\u043d. \u0416\u0435\u043b\u0438\u0448 \u043b\u0438 \u0434\u0430 \u043e\u043f\u0442\u0438\u043c\u0438\u0437\u0443\u0458\u0435\u043c \u0441\u043b\u0438\u043a\u0435 \u043a\u043e\u0458\u0435 \u0441\u0443 \u0432\u0435\u045b \u043d\u0430 \u0442\u0432\u043e\u043c \u0441\u0430\u0458\u0442\u0443?"],"Optimize my images":["\u041e\u043f\u0442\u0438\u043c\u0438\u0437\u0443\u0458 \u043c\u043e\u0458\u0435 \u0441\u043b\u0438\u043a\u0435"],"Optimize images":["\u041e\u043f\u0442\u0438\u043c\u0438\u0437\u0443\u0458 \u0441\u043b\u0438\u043a\u0435"],"Add API key":["\u0414\u043e\u0434\u0430\u0458 API \u043a\u0459\u0443\u0447"],"Do you want to add your Imagify API key next?":["\u0416\u0435\u043b\u0438\u0448 \u043b\u0438 \u0441\u0430\u0434\u0430 \u0434\u0430 \u0434\u043e\u0434\u0430\u0448 \u0441\u0432\u043e\u0458 Imagify API \u043a\u0459\u0443\u0447?"],"See plans":["\u041f\u043e\u0433\u043b\u0435\u0434\u0430\u0458 \u043f\u043b\u0430\u043d\u043e\u0432\u0435"],"Do you want to see Imagify\u2019s plans?":["\u0416\u0435\u043b\u0438\u0448 \u043b\u0438 \u0434\u0430 \u0432\u0438\u0434\u0438\u0448 \u043f\u043b\u0430\u043d\u043e\u0432\u0435 Imagify-\u0430?"]}}}