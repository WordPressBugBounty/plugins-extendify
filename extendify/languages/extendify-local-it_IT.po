#: public/build/extendify-agentx-5123061faaccc9af69d5.js:1252
#: src/AgentX/chat/ResolveChanges.jsx:144
msgid "I was unable to merge in the changes."
msgstr "Non sono riuscito a unire le modifiche."

#. translators: Button on the AI Agent's unsaved changes bar, beside Overwrite: deletes the user's own unsaved edits that couldn't be applied and keeps their other changes. Mine means my edits, said by the user, not the agent; Delete is a verb; keep it short.
#: public/build/extendify-agentx-5123061faaccc9af69d5.js:1255
#: src/AgentX/chat/ResolveChanges.jsx:169
msgid "Delete mine"
msgstr "Elimina le mie"

#. translators: Button on the AI Agent's unsaved changes bar, beside Delete mine, a verb: keeps the user's unsaved changes so the next Save writes them over the change made elsewhere. Keep it short.
#: public/build/extendify-agentx-5123061faaccc9af69d5.js:1258
#: src/AgentX/chat/ResolveChanges.jsx:180
msgid "Overwrite"
msgstr "Sovrascrivi"

