msgstr[0] "Eliminare “%1$s” e toglierla dal menù %2$s?"
msgstr[1] "Eliminare “%1$s” e toglierla dai menù %2$s?"

#. translators: %s is the title of one of the site's pages or posts. The AI Agent asks the user to confirm deleting it.
#: public/build/extendify-agentx-5123061faaccc9af69d5.js:1184
#: src/AgentX/chat/PageCard.jsx:124
#, js-format
msgid "Delete “%s”?"
msgstr "Eliminare “%s”?"

#. translators: %s is the names of the site's menus that link to the page the AI Agent is about to delete, which the user asked to keep; those links stop working.
#: public/build/extendify-agentx-5123061faaccc9af69d5.js:1187
#: src/AgentX/chat/PageCard.jsx:131
#, js-format
msgid "Its link in the %s menu stays, and will lead nowhere."
msgid_plural "Its links in the %s menus stay, and will lead nowhere."
msgstr[0] "Il suo link nel menù %s resta, e non porterà più da nessuna parte."
msgstr[1] "I suoi link nei menù %s restano, e non porteranno più da nessuna parte."

#. translators: %s is the titles of the site's pages that link to the page the AI Agent is about to delete, or how many there are, like "5 pages"; those links stop working.
#: public/build/extendify-agentx-5123061faaccc9af69d5.js:1190
#: src/AgentX/chat/PageCard.jsx:143
#, js-format
msgid "%s links to it, and that link will lead nowhere."
msgid_plural "%s link to it, and those links will lead nowhere."
msgstr[0] "%s rimanda a questa pagina, e quel link non porterà più da nessuna parte."
msgstr[1] "%s rimandano a questa pagina, e quei link non porteranno più da nessuna parte."

#. translators: %d is how many subpages the page the AI Agent is about to delete has; they stay on the site.
#: public/build/extendify-agentx-5123061faaccc9af69d5.js:1193
#: src/AgentX/chat/PageCard.jsx:155
#, js-format
msgid "It has %d subpage, which stays on the site."
msgid_plural "It has %d subpages, which stay on the site."
msgstr[0] "Ha %d sottopagina, che resta sul sito."
msgstr[1] "Ha %d sottopagine, che restano sul sito."

#. translators: Ends the AI Agent's question about deleting a page or post; WordPress keeps deleted ones in its trash for a while.
#: public/build/extendify-agentx-5123061faaccc9af69d5.js:1196
#: src/AgentX/chat/PageCard.jsx:165
msgid "It moves to the trash."
msgstr "Finisce nel cestino."

#. translators: Read out by screen readers after a step of the AI Agent's plan, the list of steps it shows, that the user stopped before it was done.
